# Bot config — copy to bot/.env

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Where the control-API is reachable.
# Local dev:  http://localhost:8080
# Hetzner:    https://<your-vps-hostname>
CONTROL_API_URL=http://localhost:8080

# Shared secret with the control-API. Must match control-api/.env (or root .env).
CONTROL_API_TOKEN=changeme_local_only

# Discord role ID allowed to run /start-server and /stop-server.
# (/server-status is open to everyone.)
MC_ADMIN_ROLE_ID=1535796235376795728

# Port for the HTTP keep-alive server (Render auto-sets this in prod).
PORT=3000
