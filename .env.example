# =============================================================================
# Minecraft-Server — configuration
# Copy to `.env` and fill in the blanks for the mode you're using.
# =============================================================================

# ---- Which backend the Phase 3 control API should use ------------------------
# local    → start/stop a Docker container on this machine (Phase 1 / 2 dev).
# hetzner  → call Hetzner Cloud API to boot/destroy a VPS from a snapshot.
MODE=local

# ---- Shared: RCON password used by benchmark harness & bot ------------------
# Must match RCON_PASSWORD used when running docker-compose.
RCON_PASSWORD=changeme_local_only

# =============================================================================
# LOCAL MODE (Phase 1 / 2)
# =============================================================================
# Nothing to configure — docker-compose.yml + scripts/ handle everything.
# The Phase 3 control API will talk to Docker on this machine.

# =============================================================================
# HETZNER MODE (Phase 3 → production)
# Fill these in when you migrate. The bot code does NOT change; only .env does.
# =============================================================================

# Hetzner Cloud API token — created at https://console.hetzner.cloud
# under Security → API Tokens. Needs "Read & Write" scope.
HETZNER_API_TOKEN=

# ID of the snapshot to boot from. After you get a server running once,
# create a snapshot via the Hetzner console and put its numeric ID here.
HETZNER_SNAPSHOT_ID=

# Server type: cpx21 (3 vCPU / 4 GB) or cpx31 (4 vCPU / 8 GB).
# Set based on your Phase 2 benchmark results.
HETZNER_SERVER_TYPE=cpx21

# Datacenter location. Singapore = sin1.
HETZNER_LOCATION=sin1

# Name to give the created server (visible in Hetzner console).
HETZNER_SERVER_NAME=mc-ondemand

# SSH key ID (numeric) to inject into the server, so you can SSH in if needed.
HETZNER_SSH_KEY_ID=

# ---- Hetzner Object Storage (S3-compatible) ---------------------------------
# Used to persist the world folder between VPS lifecycles.
# Create the bucket at https://console.hetzner.cloud → Object Storage.
HETZNER_S3_ENDPOINT=https://sin1.your-objectstorage.com
HETZNER_S3_BUCKET=
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=
HETZNER_S3_WORLD_PREFIX=worlds/

# =============================================================================
# PHASE 3 CONTROL API (added later)
# =============================================================================
# HTTP URL of the small control API that the Discord bot calls into.
# - MODE=local  : http://localhost:8080  (bot must also run locally)
# - MODE=hetzner: https://<control-api-host>  (see docs/PHASE3-PLAN.md)
CONTROL_API_URL=http://localhost:8080

# Shared secret between bot and control API. Any random string.
CONTROL_API_TOKEN=changeme_local_only

# Idle-timeout: shut down after this many minutes with 0 players.
IDLE_SHUTDOWN_MINUTES=15
