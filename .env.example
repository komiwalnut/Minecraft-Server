# =============================================================================
# Minecraft-Server — configuration
# Copy to `.env` and fill in the values for whichever mode you're using.
# =============================================================================

# ---- Backend selection ------------------------------------------------------
# local    → start/stop a Docker container on this machine.
#            Used for local dev AND for the "Always-on VPS" cloud deploy
#            (same code, run on the VPS).
# hetzner  → provision a Hetzner VPS on demand. Used for the "On-demand VPS"
#            deploy where the control-API runs on a small always-on
#            controller box and spins up the MC VPS only when needed.
MODE=local

# ---- Shared: RCON password used by benchmark, bot, and controller ------------
# In local/Always-on: must match RCON_PASSWORD used by docker-compose.
# In hetzner mode:    injected into the MC VPS via cloud-init so RCON on the
#                     MC VPS uses the same password.
RCON_PASSWORD=changeme_local_only

# ---- Control-API + bot shared config ----------------------------------------
# URL the Discord bot uses to reach the control-API.
#   local dev:         http://localhost:8080
#   Always-on VPS:     http://<vps-ip>:8080  or  https://<domain>
#   On-demand:         http://<controller-ip>:8080  or  https://<domain>
CONTROL_API_URL=http://localhost:8080

# Shared bearer token between bot and control-API. Any random string.
CONTROL_API_TOKEN=changeme_local_only

# Idle-timeout: shut down after this many minutes with 0 players.
IDLE_SHUTDOWN_MINUTES=15

# =============================================================================
# HETZNER MODE (on-demand VPS)
# Only needed if MODE=hetzner. Leave blank for local / Always-on deployments.
# =============================================================================

# Hetzner Cloud API token — created at https://console.hetzner.cloud
# under Security → API Tokens. Needs "Read & Write" scope.
HETZNER_API_TOKEN=

# Snapshot ID (numeric) to boot the MC VPS from. Create the snapshot by
# provisioning a base VPS, installing Docker + this repo + baking the
# bootstrap/shutdown scripts, then snapshotting. See docs/DEPLOY-HETZNER.md
# Model B for the base-VPS recipe.
HETZNER_SNAPSHOT_ID=

# Datacenter location. Singapore = sgp1.
HETZNER_LOCATION=sgp1

# Server type used when booting an MC VPS. cpx21 = 3 vCPU / 4 GB;
# cpx31 = 4 vCPU / 8 GB. Overridable per /start-server invocation.
HETZNER_SERVER_TYPE=cpx21

# Name to give the created MC VPS (visible in Hetzner console).
HETZNER_SERVER_NAME=mc-ondemand

# SSH key ID (numeric) to inject into the MC VPS on creation. The
# controller uses the matching private key to SSH in and run shutdown.sh
# before destroying the VPS.
HETZNER_SSH_KEY_ID=

# Path (on the controller) to the private key matching HETZNER_SSH_KEY_ID.
# Example: /root/.ssh/mc_controller_ed25519
HETZNER_SSH_PRIVATE_KEY_PATH=

# ---- Hetzner Object Storage (S3-compatible) ---------------------------------
# The world folder lives here between VPS lifecycles. Create the bucket at
# https://console.hetzner.cloud → Object Storage → Create Bucket (region sgp1).
# The access key + secret come from Object Storage → Credentials.
HETZNER_S3_ENDPOINT=https://sgp1.your-objectstorage.com
HETZNER_S3_BUCKET=
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=

# Prefix inside the bucket. Trailing slash matters — objects will live at
# s3://<bucket>/<prefix><world files>. Leave as-is unless you have a reason.
HETZNER_S3_WORLD_PREFIX=worlds/latest/
